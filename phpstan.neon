includes:
    - %currentWorkingDirectory%/vendor/craftcms/phpstan/phpstan.neon

parameters:
    level: 5
    paths:
        - src
    ignoreErrors:
    -   '#Class studioespresso\\easyaddressfield\\models\\EasyAddressFieldModel not found.#'
    -   '#Class studioespresso\\easyaddressfield\\fields\\EasyAddressFieldField not found.#'
    -   '#Access to property \$[a-zA-Z0-9\\_]+ on an unknown class studioespresso\\easyaddressfield\\models\\EasyAddressFieldModel.#'
    -   '#Access to property \$[a-zA-Z0-9\\_]+ on an unknown class doublesecretagency\\googlemaps\\models\\Address.#'
    -   '#Class doublesecretagency\\googlemaps\\fields\\AddressField not found.#'
    -   '#Class doublesecretagency\\googlemaps\\models\\Address not found.#'
    reportUnmatchedIgnoredErrors: false